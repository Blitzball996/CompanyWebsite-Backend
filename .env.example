# Server
PORT=8090
# Comma-separated allowed origins for the collect endpoint (your website URLs)
ALLOWED_ORIGINS=http://localhost:8080,https://blitzball996.github.io

# PostgreSQL
DATABASE_URL=postgres://analytics:analytics@localhost:5432/analytics?sslmode=disable

# Dashboard login (change these!)
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-please

# Salt for hashing visitor IP+UA into an anonymous id (change to a random string)
VISITOR_SALT=please-change-this-random-salt

# ---- Payments (Creem) ----
# Signing secret from the Creem dashboard → webhook settings.
CREEM_WEBHOOK_SECRET=
# Maps a Creem product id to a license prefix. Blitz DAW and CloseCrab Pro are
# both built in; override or extend here, comma-separated.
#   BDST/BDPR = Blitz DAW standard/pro · CCST/CCPR = CloseCrab standard/pro
CREEM_PRODUCT_MAP=prod_7MP9FYacUK2RwtfD1LI3oe:BDPR,prod_52UST52fNxBYDbP1fqrBCJ:CCPR

# ---- Paid downloads ----
# HMAC key signing the short-lived download links. Use a long random string.
# Falls back to WEBHOOK_SECRET if unset; set it explicitly in production.
DOWNLOAD_SECRET=change-me-to-a-long-random-string
